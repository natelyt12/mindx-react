# Set default behavior to automatically detect text files and normalize line endings to LF
* text=auto eol=lf

# Enforce LF for specific text file types
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Denote all binary files explicitly so Git does not modify them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

